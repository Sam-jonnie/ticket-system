# --- Database (host port 5436 is what docker-compose.yml publishes) ---
DATABASE_URL=postgresql+psycopg://ticket_user:ticket_pass@localhost:5436/ticket_system

# --- JWT ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development

# --- Redis (Celery broker, rate limiting, dashboard cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# --- Email (Mailpit catches everything in development: http://localhost:8025) ---
EMAIL_ENABLED=true
EMAIL_FROM=support@ticket-system.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false